# Only build inputs and license notices are copied by Dockerfile.
**
!LICENSE
!NOTICE.md
!package.json
!package-lock.json
!tsconfig*.json
!src/
!src/**
!Dockerfile
!.dockerignore

# Keep accidental runtime data and secrets out even if they appear under src.
**/.env
**/.env.*
**/*.pem
**/*.key
**/memory-token.txt
**/*.mnemo-backup
**/*.log
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.db-*
**/*.tgz
