{
  "name": "mnemosy-ai",
  "version": "2.0.0-rc.9",
  "description": "Evidence-backed agent memory with observation, hybrid recall, temporal history, tested skills, and local MCP/HTTP",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mnemosy": "./dist/cli/index.js"
  },
  "exports": {
    "./migration": {
      "types": "./dist/migration/index.d.ts",
      "import": "./dist/migration/index.js"
    },
    "./maintenance": {
      "types": "./dist/maintenance/index.d.ts",
      "import": "./dist/maintenance/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./providers/local": {
      "types": "./dist/providers/local.d.ts",
      "import": "./dist/providers/local.js"
    },
    "./branches": {
      "types": "./dist/branches/index.d.ts",
      "import": "./dist/branches/index.js"
    },
    "./relations": {
      "types": "./dist/relations/index.d.ts",
      "import": "./dist/relations/index.js"
    },
    "./connectors": {
      "types": "./dist/connectors/index.d.ts",
      "import": "./dist/connectors/index.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "import": "./dist/local/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    },
    "./reflection": {
      "types": "./dist/reflection/index.d.ts",
      "import": "./dist/reflection/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./cognitive": {
      "types": "./dist/cognitive/index.d.ts",
      "import": "./dist/cognitive/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js"
    },
    "./broadcast": {
      "types": "./dist/broadcast/index.d.ts",
      "import": "./dist/broadcast/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation/index.d.ts",
      "import": "./dist/evaluation/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js"
    },
    "./operations": {
      "types": "./dist/operations/index.d.ts",
      "import": "./dist/operations/index.js"
    },
    "./profiles": {
      "types": "./dist/profiles/index.d.ts",
      "import": "./dist/profiles/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js"
    },
    "./local/embedding": {
      "types": "./dist/local/embedding/index.d.ts",
      "import": "./dist/local/embedding/index.js"
    },
    "./local/reranking": {
      "types": "./dist/local/reranking/index.d.ts",
      "import": "./dist/local/reranking/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "ARCHITECTURE.md",
    "COMPARISON.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "DESIGN.md",
    "assets",
    "docs",
    "site",
    "python",
    "examples",
    "!**/.env",
    "!**/.env.*",
    "!**/*.pem",
    "!**/*.key",
    "!**/memory-token.txt",
    "!**/*.mnemo-backup",
    "!**/*.log",
    "!**/*.tgz",
    "!**/*.sqlite",
    "!**/*.sqlite-*",
    "!**/*.sqlite3",
    "!**/*.sqlite3-*",
    "!**/*.db",
    "!**/*.db-*"
  ],
  "scripts": {
    "benchmark": "node dist/evaluation/locomo-benchmark.js",
    "benchmark:agent": "node dist/cli/index.js benchmark-agent",
    "benchmark:corpus": "node dist/evaluation/corpus-cli.js",
    "benchmark:evidence": "node dist/evaluation/evidence-benchmark.js",
    "benchmark:fetch": "node scripts/fetch-benchmark-corpus.mjs",
    "benchmark:matched": "node dist/evaluation/matched-benchmark.js",
    "benchmark:matched:install": "npm ci --prefix benchmarks/competitors",
    "benchmark:scale": "node dist/evaluation/local-benchmark.js",
    "build": "tsc",
    "check": "npm run typecheck && npm test && npm run typecheck:examples",
    "check:docs": "node --test scripts/check-doc-links.test.mjs && node scripts/check-doc-links.mjs",
    "check:public": "node --test scripts/check-public-metadata.test.mjs && node scripts/check-public-metadata.mjs",
    "clean": "rm -rf dist",
    "demo": "node dist/cli/index.js demo",
    "demo:learning": "node dist/cli/index.js learning-demo",
    "demo:record": "node dist/cli/index.js demo --record",
    "evaluate": "node dist/cli/index.js evaluate",
    "posttest": "node scripts/check-env-gated-tests.mjs",
    "prepublishOnly": "npm run clean && npm run check",
    "pretest": "npm run build",
    "pretest:coverage": "npm run build",
    "pretest:watch": "npm run build",
    "setup:embedder": "node scripts/fetch-local-model.mjs",
    "setup:reranker": "node scripts/fetch-local-reranker.mjs",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report.json",
    "test:coverage": "vitest run --coverage",
    "test:python": "PYTHONPATH=python python3 -m unittest discover -s python/tests -v",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext --ignoreConfig --types node examples/basic-usage.ts examples/with-redis.ts examples/with-falkordb.ts examples/runtime-learning.ts examples/anthropic-memory.ts examples/provider-memory-tools.ts examples/migration.ts examples/maintenance.ts examples/agent-loop.ts examples/adaptive-context.ts examples/agent-benchmark.ts examples/backup-restore.ts examples/profiles.ts examples/gradual-migration.ts examples/local-semantic.ts"
  },
  "keywords": [
    "ai",
    "memory",
    "agents",
    "cognitive",
    "vector",
    "knowledge-graph",
    "llm",
    "embeddings",
    "multi-agent",
    "mcp",
    "local-first",
    "temporal-memory",
    "memory-migration",
    "agent-memory"
  ],
  "license": "MIT",
  "author": {
    "name": "Aristotle Intelligence Inc.",
    "email": "28naem@gmail.com",
    "url": "https://mnemosy.ai"
  },
  "homepage": "https://mnemosy.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/28naem-del/mnemosyne"
  },
  "bugs": {
    "url": "https://github.com/28naem-del/mnemosyne/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "onnxruntime-node": "^1.29.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "@huggingface/transformers": "3.8.1",
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^25.9.6",
    "@vitest/coverage-v8": "^5.0.0",
    "ioredis": "^5.11.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "optionalDependencies": {
    "hnswlib-node": "3.0.0",
    "sqlite-vec": "^0.1.9"
  }
}
