{
  "name": "mnemosy-ai",
  "version": "2.0.0-rc.1",
  "description": "Portable agent memory with evidence, corrections, scoped handoffs, and a local MCP server",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mnemosy": "./dist/cli/index.js"
  },
  "exports": {
    "./local": {
      "types": "./dist/local/index.d.ts",
      "import": "./dist/local/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    },
    "./reflection": {
      "types": "./dist/reflection/index.d.ts",
      "import": "./dist/reflection/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./cognitive": {
      "types": "./dist/cognitive/index.d.ts",
      "import": "./dist/cognitive/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js"
    },
    "./broadcast": {
      "types": "./dist/broadcast/index.d.ts",
      "import": "./dist/broadcast/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "docs",
    "site"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test && npm run typecheck:examples",
    "demo": "node dist/cli/index.js demo",
    "demo:record": "node dist/cli/index.js demo --record",
    "benchmark": "node dist/evaluation/local-benchmark.js",
    "pretest": "npm run build",
    "pretest:coverage": "npm run build",
    "test:watch": "vitest",
    "pretest:watch": "npm run build",
    "typecheck:examples": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext --ignoreConfig --types node examples/basic-usage.ts examples/with-redis.ts examples/with-falkordb.ts"
  },
  "keywords": [
    "ai",
    "memory",
    "agents",
    "cognitive",
    "vector",
    "knowledge-graph",
    "qdrant",
    "llm",
    "embeddings",
    "multi-agent",
    "self-improving",
    "openai",
    "anthropic",
    "langchain",
    "crewai"
  ],
  "license": "MIT",
  "author": "Mnemosyne Team",
  "homepage": "https://mnemosy.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/28naem-del/mnemosyne"
  },
  "bugs": {
    "url": "https://github.com/28naem-del/mnemosyne/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^25.9.6",
    "@vitest/coverage-v8": "^5.0.0",
    "ioredis": "^5.11.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
