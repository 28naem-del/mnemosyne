# package.json "files" is the release allowlist: dist, docs, site, python,
# examples, branding assets, root guides and license notices.
# Sensitive/runtime exclusions are also in that file list because an explicit
# directory allowlist takes precedence over this root ignore file.
node_modules/
src/
tests/
coverage/
.github/
.git/
.idea/
.vscode/
.env
.env.*
*.pem
*.key
memory-token.txt
*.mnemo-backup
*.log
*.tgz
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
.DS_Store
Thumbs.db
